<ui:FluentWindow x:Class="MouseFix.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="MouseFix" Width="860" Height="660" MinWidth="720" MinHeight="460" ResizeMode="CanResize"
                 WindowStartupLocation="Manual" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 Closing="Window_Closing">
    <ui:FluentWindow.Resources>
        <!-- Sidebar entries; the selected one switches to the "Secondary" look in code. -->
        <Style x:Key="NavButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Title" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="ui:TextBlock">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="MouseFix" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/mousefix.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <DockPanel Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Bottom">
                    <ui:TextBlock x:Name="VersionText" Appearance="Tertiary" Margin="12,0,0,8" />
                </StackPanel>
                <StackPanel>
                    <ui:Button x:Name="NavHome" Tag="Home" Style="{StaticResource NavButton}" Content="Início"
                               Icon="{ui:SymbolIcon Home24}" Click="NavButton_Click" />
                    <ui:Button x:Name="NavProfiles" Tag="Profiles" Style="{StaticResource NavButton}" Content="Perfis"
                               Icon="{ui:SymbolIcon AppsList24}" Click="NavButton_Click" />
                    <ui:Button x:Name="NavEmulator" Tag="Emulator" Style="{StaticResource NavButton}" Content="Emulador"
                               Icon="{ui:SymbolIcon Games24}" Click="NavButton_Click" />
                    <ui:Button x:Name="NavTests" Tag="Tests" Style="{StaticResource NavButton}" Content="Testes"
                               Icon="{ui:SymbolIcon Gauge24}" Click="NavButton_Click" />
                    <ui:Button x:Name="NavSettings" Tag="Settings" Style="{StaticResource NavButton}" Content="Configurações"
                               Icon="{ui:SymbolIcon Settings24}" Click="NavButton_Click" />
                </StackPanel>
            </DockPanel>

            <!-- ============ Pages (one visible at a time) ============ -->
            <Grid Grid.Column="1">

                <!-- ===== Início ===== -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,24,24">
                        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Início" />
                        <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="Aceleração do mouse no Windows e velocidade do ponteiro." />

                        <!-- Status with the main actions -->
                        <ui:Card Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon x:Name="StatusIcon" FontSize="48" Filled="True" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <ui:TextBlock x:Name="StatusText" FontTypography="Subtitle" />
                                    <ui:TextBlock x:Name="StatusSubtext" Appearance="Secondary" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                                    <ui:Button x:Name="FixButton" Content="Remover aceleração" Icon="{ui:SymbolIcon Checkmark24}"
                                               Appearance="Primary" Click="FixButton_Click" />
                                    <ui:Button x:Name="RestoreButton" Content="Restaurar original" Icon="{ui:SymbolIcon ArrowUndo24}"
                                               Margin="8,0,0,0" Click="RestoreButton_Click" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- New version available -->
                        <ui:Card x:Name="UpdateCard" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <ui:TextBlock x:Name="UpdateTitle" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="Baixe o instalador novo; suas configurações continuam." Appearance="Secondary" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="Baixar" Appearance="Primary" VerticalAlignment="Center"
                                           Click="UpdateDownloadButton_Click" />
                            </Grid>
                        </ui:Card>

                        <ui:InfoBar x:Name="MouseSoftwareInfo" Margin="0,8,0,0" Severity="Warning" IsClosable="False" />

                        <ui:TextBlock Style="{StaticResource SectionLabel}" Text="Velocidade do ponteiro" />
                        <ui:Card>
                            <StackPanel>
                                <Grid>
                                    <ui:TextBlock Text="Sem aceleração em qualquer valor" Appearance="Secondary" VerticalAlignment="Center" />
                                    <ui:TextBlock x:Name="SpeedChoiceValue" FontTypography="BodyStrong" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" Margin="0,8,0,0" ValueChanged="SpeedSlider_ValueChanged" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock x:Name="SpeedChoiceHint" Appearance="Secondary" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ui:Button x:Name="SpeedResetButton" Grid.Column="1" Content="Voltar para 1:1" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Click="SpeedResetButton_Click" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:TextBlock Style="{StaticResource SectionLabel}" Text="Situação atual do Windows" />
                        <ui:Card>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ui:TextBlock Text="Aumentar precisão do ponteiro (aceleração)" Appearance="Secondary" />
                                <ui:TextBlock x:Name="AccelValue" Grid.Column="1" FontTypography="BodyStrong" />
                                <ui:TextBlock Grid.Row="1" Text="Velocidade do ponteiro" Appearance="Secondary" Margin="0,8,0,0" />
                                <ui:TextBlock x:Name="SpeedValue" Grid.Row="1" Grid.Column="1" FontTypography="BodyStrong" Margin="0,8,0,0" />
                                <ui:TextBlock Grid.Row="2" Text="Curvas de proteção" Appearance="Secondary" Margin="0,8,0,0" />
                                <ui:TextBlock x:Name="CurvesValue" Grid.Row="2" Grid.Column="1" FontTypography="BodyStrong" Margin="0,8,0,0" />
                            </Grid>
                        </ui:Card>

                        <ui:InfoBar x:Name="LoginInfo" Margin="0,8,0,0" Severity="Informational" IsClosable="False"
                                    Title="Configurações salvas"
                                    Message="Seu backup está guardado. As curvas de proteção passam a valer no próximo login do Windows." />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Perfis ===== -->
                <ScrollViewer x:Name="PageProfiles" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="16,4,24,24">
                        <Grid Margin="0,0,0,4">
                            <ui:TextBlock Style="{StaticResource PageTitle}" Text="Perfis por programa" Margin="0" />
                            <ui:Button Content="Adicionar programa" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddProfileButton_Click" />
                        </Grid>
                        <ui:TextBlock x:Name="ProfilesHint" Style="{StaticResource PageSubtitle}" />
                        <ui:Card>
                            <StackPanel>
                                <StackPanel x:Name="ProfilesList" />
                                <ui:TextBlock x:Name="ProfilesEmpty" Appearance="Tertiary" TextWrapping="Wrap" HorizontalAlignment="Center"
                                              Margin="0,12" Text="Nenhum perfil ainda. Clique em &quot;Adicionar programa&quot;." />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Emulador ===== -->
                <ScrollViewer x:Name="PageEmulator" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="16,4,24,24">
                        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Emulador" />
                        <ui:TextBlock Style="{StaticResource PageSubtitle}"
                                      Text="Mira do Free Fire no MSI App Player / BlueStacks 5: aceleração do emulador, teste e sensibilidade." />

                        <ui:Card x:Name="EmulatorEmpty">
                            <StackPanel Margin="0,8">
                                <ui:SymbolIcon Symbol="Games24" FontSize="36" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="Nenhum emulador compatível encontrado" FontTypography="BodyStrong"
                                              HorizontalAlignment="Center" Margin="0,8,0,2" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" TextAlignment="Center"
                                              Text="Suportado: MSI App Player e BlueStacks 5 com Free Fire ou Free Fire MAX. Abra o jogo no emulador uma vez e volte aqui." />
                            </StackPanel>
                        </ui:Card>

                        <StackPanel x:Name="EmulatorCard" Visibility="Collapsed">
                            <ui:Card>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="22" />
                                        <ui:TextBlock x:Name="EmulatorTitle" FontTypography="Subtitle" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock Text="Aceleração do emulador" Appearance="Secondary" />
                                        <ui:TextBlock x:Name="EmulatorAccelValue" Grid.Column="1" FontTypography="BodyStrong" />
                                        <ui:TextBlock Grid.Row="1" Text="Esquema de controles" Appearance="Secondary" Margin="0,8,0,0" />
                                        <ui:TextBlock x:Name="EmulatorSchemeValue" Grid.Row="1" Grid.Column="1" FontTypography="BodyStrong" Margin="0,8,0,0" />
                                        <ui:TextBlock Grid.Row="2" Text="Sensibilidade da mira (X / Y)" Appearance="Secondary" Margin="0,8,0,0" />
                                        <ui:TextBlock x:Name="EmulatorSensValue" Grid.Row="2" Grid.Column="1" FontTypography="BodyStrong" Margin="0,8,0,0" />
                                    </Grid>
                                    <ui:Button x:Name="EmulatorFixButton" Content="Desligar aceleração do emulador" Icon="{ui:SymbolIcon Checkmark24}"
                                               Appearance="Primary" Margin="0,14,0,0" Click="EmulatorFixButton_Click" />
                                </StackPanel>
                            </ui:Card>

                            <ui:TextBlock Style="{StaticResource SectionLabel}" Text="Windows e a mira do jogo" />
                            <ui:Card>
                                <StackPanel>
                                    <ui:TextBlock x:Name="EmulatorAdvice" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <ui:Button x:Name="EmulatorTestButton" Content="Testar emulador" Icon="{ui:SymbolIcon Beaker24}"
                                                   Click="EmulatorTestButton_Click" />
                                        <ui:Button x:Name="EmulatorSensButton" Appearance="Primary" Margin="8,0,0,0"
                                                   Click="EmulatorSensButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Testes ===== -->
                <ScrollViewer x:Name="PageTests" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="16,4,24,24">
                        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Testes" />
                        <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="Prove que o mouse está sem aceleração, do sensor até o cursor." />

                        <ui:CardAction Icon="{ui:SymbolIcon CursorClick24}" Click="TestButton_Click">
                            <StackPanel>
                                <ui:TextBlock Text="Precisão do Windows" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                              Text="Compara o sensor do mouse com o cursor em movimentos lentos e rápidos. Mostra se o Windows está 1:1." />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon Ruler24}" Margin="0,8,0,0" Click="DistanceTestButton_Click">
                            <StackPanel>
                                <ui:TextBlock Text="Distância (mouse e driver)" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                              Text="Arraste o mouse a mesma distância devagar e rápido. Mostra aceleração no mouse ou no driver (ex.: Razer Synapse), o DPI real e o polling rate." />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon Games24}" Margin="0,8,0,0" Tag="Emulator" Click="NavButton_Click">
                            <StackPanel>
                                <ui:TextBlock Text="Teste do emulador" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                              Text="Descobre se a mira do Free Fire no emulador segue o cursor do Windows. Fica na seção Emulador." />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Configurações ===== -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="16,4,24,24">
                        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Configurações" />
                        <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="Comportamento do MouseFix em segundo plano." />

                        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="Proteção automática" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="Desliga a aceleração de novo se algum programa religar" Appearance="Secondary" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoReapplyToggle" Click="AutoReapplyToggle_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Power24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="Iniciar com o Windows" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="Abre minimizado na bandeja ao ligar o PC" Appearance="Secondary" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoStartToggle" Click="AutoStartToggle_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon ArrowSync24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="Avisar quando sair versão nova" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="Consulta o GitHub uma vez por dia. É o único acesso à internet do MouseFix." Appearance="Secondary" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UpdateCheckToggle" Click="UpdateCheckToggle_Click" />
                        </ui:CardControl>

                        <ui:TextBlock Style="{StaticResource SectionLabel}" Text="Ajuda" />
                        <ui:CardAction Icon="{ui:SymbolIcon Bug24}" Click="ReportButton_Click">
                            <StackPanel>
                                <ui:TextBlock Text="Reportar problema" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                              Text="Abre o GitHub com um relatório preenchido (versão, Windows e log). Você revisa antes de enviar." />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon Folder24}" Margin="0,4,0,0" Click="LogFolderButton_Click">
                            <StackPanel>
                                <ui:TextBlock Text="Abrir pasta de logs" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" Text="Backup, configurações e registro do que o MouseFix fez." />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:TextBlock Style="{StaticResource SectionLabel}" Text="Sobre" />
                        <ui:CardAction Icon="{ui:SymbolIcon Info24}" Click="GitHubButton_Click">
                            <StackPanel>
                                <ui:TextBlock x:Name="AboutText" FontTypography="BodyStrong" />
                                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                              Text="Grátis e de código aberto (licença MIT). Abrir a página do projeto no GitHub." />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
