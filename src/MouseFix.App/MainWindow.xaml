<ui:FluentWindow x:Class="MouseFix.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MouseFix.App"
                 Title="MouseFix" Width="1080" Height="740" MinWidth="900" MinHeight="560" ResizeMode="CanResize"
                 WindowStartupLocation="Manual" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{StaticResource MfWindowBackground}"
                 Closing="Window_Closing">
    <ui:FluentWindow.Resources>
        <!-- Sidebar entry: icon + label; the checked one gets the blue pill and the accent bar. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MfTextMuted}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Height="48">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,11"
                                        Background="{StaticResource MfAccent}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="Icon" FontSize="22" Foreground="{TemplateBinding Foreground}"
                                                   Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MfNavHover}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MfNavSelected}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource MfAccent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource MfTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,24" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MfTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,24,0,10" />
        </Style>

        <!-- Square − / + buttons of the scroll stepper. -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MfNavHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Looks like a dropdown; opens the Perfis section. -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource MfPanelBorder}"
                                Background="#0B121D" Padding="16,0" Height="52">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource MfAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <!-- Title bar with the two-tone logo drawn over it (clicks pass through to the title bar). -->
        <Grid DockPanel.Dock="Top">
            <ui:TitleBar Title="" Height="52" />
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/mousefix.png" Width="22" Height="22" />
                <TextBlock FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Run Text="Mouse" Foreground="White" /><Run Text="Fix" Foreground="{StaticResource MfAccent}" />
                </TextBlock>
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource MfDivider}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Background="{StaticResource MfSidebarBackground}" BorderBrush="{StaticResource MfDivider}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,24,14,16">
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="18,0,0,0" />
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="Visão geral"
                                     Tag="{x:Static ui:SymbolRegular.Home24}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" Content="Perfis"
                                     Tag="{x:Static ui:SymbolRegular.AppsList24}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavEmulator" Style="{StaticResource NavItem}" Content="Emulador"
                                     Tag="{x:Static ui:SymbolRegular.Games24}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTests" Style="{StaticResource NavItem}" Content="Testes"
                                     Tag="{x:Static ui:SymbolRegular.Gauge24}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Configurações"
                                     Tag="{x:Static ui:SymbolRegular.Settings24}" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Visão geral ===== -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,22,40,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Ajustes do mouse" />
                                <TextBlock Style="{StaticResource PageSubtitle}" Text="Remova a aceleração e controle o seu cursor." />
                            </StackPanel>
                            <!-- Current state at a glance + the one-click fix -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Orientation="Horizontal">
                                <Border x:Name="StatusPill" CornerRadius="16" Padding="14,7" Background="#10233A" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="StatusIcon" FontSize="18" Filled="True" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusText" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ui:Button x:Name="RemoveAccelButton" Content="Remover aceleração" Icon="{ui:SymbolIcon CursorClick24}"
                                           Appearance="Primary" Height="44" Padding="20,0" FontSize="15" FontWeight="SemiBold"
                                           Margin="14,0,0,0" VerticalAlignment="Center" Click="RemoveAccelButton_Click"
                                           ToolTip="Desliga toda a aceleração do Windows (e do emulador, se houver) com um clique" />
                            </StackPanel>
                        </Grid>

                        <!-- New version available -->
                        <Border x:Name="UpdateCard" Style="{StaticResource MfPanelStyle}" Padding="20,16" Margin="0,0,0,20"
                                BorderBrush="{StaticResource MfAccent}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="{StaticResource MfAccent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateTitle" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Baixe o instalador novo; suas configurações continuam." />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="Baixar" Appearance="Primary" VerticalAlignment="Center"
                                           Click="UpdateDownloadButton_Click" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Pointer settings -->
                            <Border Style="{StaticResource MfPanelStyle}" Padding="28,22">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="30" Foreground="White" />
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Configurações do ponteiro" />
                                    </StackPanel>

                                    <Grid Margin="0,24,0,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Velocidade do ponteiro" />
                                        <TextBlock x:Name="SpeedChoiceValue" Style="{StaticResource Muted}" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="SpeedSlider" Style="{StaticResource MfSlider}" Minimum="1" Maximum="20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,14,0,0"
                                            ValueChanged="SpeedSlider_ValueChanged" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SpeedChoiceHint" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                        <ui:Button x:Name="SpeedResetButton" Grid.Column="1" Content="Voltar para 1:1" Appearance="Transparent"
                                                   Foreground="{StaticResource MfAccent}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Click="SpeedResetButton_Click" />
                                    </Grid>

                                    <Border Style="{StaticResource MfDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Aceleração do mouse" />
                                            <TextBlock x:Name="AccelHint" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="AccelToggle" Grid.Column="1" VerticalAlignment="Center"
                                                         Checked="AccelToggle_Changed" Unchecked="AccelToggle_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource MfDividerStyle}" />

                                    <Grid>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Velocidade de rolagem" />
                                        <TextBlock x:Name="ScrollValue" Style="{StaticResource Muted}" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border HorizontalAlignment="Right" Margin="0,14,0,0" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{StaticResource MfPanelBorder}" Background="#0B121D">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ScrollDown" Style="{StaticResource StepButton}" Content="−" Click="ScrollDown_Click" />
                                            <Border Width="1" Background="{StaticResource MfPanelBorder}" />
                                            <TextBlock x:Name="ScrollNumber" Width="58" FontSize="17" Foreground="White" TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border Width="1" Background="{StaticResource MfPanelBorder}" />
                                            <Button x:Name="ScrollUp" Style="{StaticResource StepButton}" Content="+" Click="ScrollUp_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Right column: movement test + current profile -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource MfPanelStyle}" Padding="24,22">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Target24" FontSize="28" Foreground="White" />
                                            <TextBlock Style="{StaticResource PanelTitle}" Text="Teste de movimento" />
                                        </StackPanel>
                                        <Border Margin="0,16,0,0" Height="180" CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{StaticResource MfPanelBorder}" Background="#0B121D">
                                            <local:MovementTrail Accent="{StaticResource MfAccentColor}" GridBrush="{StaticResource MfGridLine}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Muted}" Text="Mova o cursor nesta área." HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MfPanelStyle}" Padding="24,16" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Text="Perfil atual" FontSize="15" />
                                        <Button Style="{StaticResource FieldButton}" Margin="0,10,0,0" Click="CurrentProfile_Click"
                                                ToolTip="Perfis trocam a velocidade sozinhos quando um programa abre. Clique para ver os perfis.">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                                                <TextBlock x:Name="CurrentProfileText" Grid.Column="1" Foreground="White" FontSize="16"
                                                           Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronDown24" FontSize="18" Foreground="White" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Perfis ===== -->
                <ScrollViewer x:Name="PageProfiles" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,30,40,24">
                        <Grid>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Perfis" />
                            <ui:Button Content="Adicionar programa" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddProfileButton_Click" />
                        </Grid>
                        <TextBlock x:Name="ProfilesHint" Style="{StaticResource PageSubtitle}" />
                        <Border Style="{StaticResource MfPanelStyle}">
                            <StackPanel>
                                <StackPanel x:Name="ProfilesList" />
                                <TextBlock x:Name="ProfilesEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16"
                                           Text="Nenhum perfil ainda. Clique em &quot;Adicionar programa&quot; (ex.: o emulador)." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Emulador ===== -->
                <ScrollViewer x:Name="PageEmulator" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,30,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Emulador" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Mira do Free Fire no MSI App Player / BlueStacks 5: aceleração do emulador, teste e sensibilidade." />

                        <Border x:Name="EmulatorEmpty" Style="{StaticResource MfPanelStyle}">
                            <StackPanel Margin="0,10">
                                <ui:SymbolIcon Symbol="Games24" FontSize="40" Foreground="{StaticResource MfAccent}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource RowTitle}" Text="Nenhum emulador compatível encontrado"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center"
                                           Text="Suportado: MSI App Player e BlueStacks 5 com Free Fire ou Free Fire MAX. Abra o jogo no emulador uma vez e volte aqui." />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="EmulatorCard" Visibility="Collapsed">
                            <Border Style="{StaticResource MfPanelStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="28" Foreground="White" />
                                        <TextBlock x:Name="EmulatorTitle" Style="{StaticResource PanelTitle}" />
                                    </StackPanel>
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Muted}" Text="Aceleração do emulador" />
                                        <TextBlock x:Name="EmulatorAccelValue" Grid.Column="1" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Esquema de controles" Margin="0,10,0,0" />
                                        <TextBlock x:Name="EmulatorSchemeValue" Grid.Row="1" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Sensibilidade da mira (X / Y)" Margin="0,10,0,0" />
                                        <TextBlock x:Name="EmulatorSensValue" Grid.Row="2" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    </Grid>
                                    <ui:Button x:Name="EmulatorFixButton" Content="Desligar aceleração do emulador" Icon="{ui:SymbolIcon Checkmark24}"
                                               Appearance="Primary" Margin="0,18,0,0" Click="EmulatorFixButton_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="Windows e a mira do jogo" />
                            <Border Style="{StaticResource MfPanelStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="EmulatorAdvice" Foreground="White" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <ui:Button x:Name="EmulatorTestButton" Content="Testar emulador" Icon="{ui:SymbolIcon Beaker24}"
                                                   Click="EmulatorTestButton_Click" />
                                        <ui:Button x:Name="EmulatorSensButton" Appearance="Primary" Margin="8,0,0,0"
                                                   Click="EmulatorSensButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Testes ===== -->
                <ScrollViewer x:Name="PageTests" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,30,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Testes" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Prove que o mouse está sem aceleração, do sensor até o cursor." />

                        <ui:InfoBar x:Name="MouseSoftwareInfo" Margin="0,0,0,12" Severity="Warning" IsClosable="False" />

                        <ui:CardAction Icon="{ui:SymbolIcon CursorClick24}" Click="TestButton_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Precisão do Windows" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="Compara o sensor do mouse com o cursor em movimentos lentos e rápidos. Mostra se o Windows está 1:1." />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon Ruler24}" Margin="0,10,0,0" Click="DistanceTestButton_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Distância (mouse e driver)" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="Arraste o mouse a mesma distância devagar e rápido. Mostra aceleração no mouse ou no driver (ex.: Razer Synapse), o DPI real e o polling rate." />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon Games24}" Margin="0,10,0,0" Click="GoToEmulator_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Teste do emulador" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="Descobre se a mira do Free Fire no emulador segue o cursor do Windows. Fica na seção Emulador." />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Configurações ===== -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,30,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Configurações" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Comportamento do MouseFix em segundo plano." />

                        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" FontSize="15" Text="Proteção automática" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Volta para as suas configurações se algum programa mudar a aceleração ou a velocidade" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoReapplyToggle" Click="AutoReapplyToggle_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon Power24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" FontSize="15" Text="Iniciar com o Windows" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Abre minimizado na bandeja ao ligar o PC" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoStartToggle" Click="AutoStartToggle_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon ArrowSync24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" FontSize="15" Text="Avisar quando sair versão nova" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Consulta o GitHub uma vez por dia. É o único acesso à internet do MouseFix." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UpdateCheckToggle" Click="UpdateCheckToggle_Click" />
                        </ui:CardControl>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="Situação atual do Windows" />
                        <Border Style="{StaticResource MfPanelStyle}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Muted}" Text="Aumentar precisão do ponteiro (aceleração)" />
                                <TextBlock x:Name="AccelValue" Grid.Column="1" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Velocidade do ponteiro" Margin="0,8,0,0" />
                                <TextBlock x:Name="SpeedValue" Grid.Row="1" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Linhas por giro da roda" Margin="0,8,0,0" />
                                <TextBlock x:Name="ScrollCurrentValue" Grid.Row="2" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Curvas de proteção" Margin="0,8,0,0" />
                                <TextBlock x:Name="CurvesValue" Grid.Row="3" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                        <ui:InfoBar x:Name="LoginInfo" Margin="0,8,0,0" Severity="Informational" IsClosable="False"
                                    Title="Backup guardado"
                                    Message="Suas configurações originais estão salvas. As curvas de proteção passam a valer no próximo login do Windows." />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="Ajuda" />
                        <ui:CardAction Icon="{ui:SymbolIcon Bug24}" Click="ReportButton_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" FontSize="15" Text="Reportar problema" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Abre o GitHub com um relatório preenchido (versão, Windows e log). Você revisa antes de enviar." />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon Folder24}" Margin="0,6,0,0" Click="LogFolderButton_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" FontSize="15" Text="Abrir pasta de logs" />
                                <TextBlock Style="{StaticResource Muted}" Text="Backup, configurações e registro do que o MouseFix fez." />
                            </StackPanel>
                        </ui:CardAction>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="Sobre" />
                        <ui:CardAction Icon="{ui:SymbolIcon Info24}" Click="GitHubButton_Click">
                            <StackPanel>
                                <TextBlock x:Name="AboutText" Style="{StaticResource RowTitle}" FontSize="15" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Grátis e de código aberto (licença MIT). Abrir a página do projeto no GitHub." />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Footer (Visão geral): pending state + apply ===== -->
                <Border x:Name="Footer" Grid.Row="1" BorderBrush="{StaticResource MfDivider}" BorderThickness="0,1,0,0" Padding="40,18">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="FooterIcon" FontSize="26" VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" FontSize="15" Margin="14,0,0,0"
                                       VerticalAlignment="Center" MaxWidth="420" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="RestoreButton" Content="Restaurar original" Appearance="Transparent"
                                       BorderBrush="#3A475B" BorderThickness="1" Height="48" Padding="24,0" FontSize="15"
                                       Click="RestoreButton_Click"
                                       ToolTip="Volta as configurações que o seu Windows tinha antes do MouseFix" />
                            <ui:Button x:Name="FixButton" Content="Aplicar configurações" Appearance="Primary"
                                       Height="48" Padding="28,0" FontSize="15" Margin="14,0,0,0" Click="FixButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
