<ui:FluentWindow x:Class="MouseFix.App.PrecisionTestWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Teste de precisão" Width="520" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{StaticResource MfWindowBackground}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Teste de precisão" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,20">
            <TextBlock Style="{StaticResource MfMutedText}"
                       Text="Mova o mouse sobre a área abaixo: alguns movimentos bem devagar e outros bem rápidos, em várias direções. O teste compara o que o sensor do mouse leu com o quanto o cursor andou." />

            <!-- Movement area -->
            <Border x:Name="TestArea" Height="150" Margin="0,14,0,0" Style="{StaticResource MfTestAreaStyle}">
                <StackPanel x:Name="AreaHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CursorHover24" FontSize="30" Foreground="{StaticResource MfAccent}" HorizontalAlignment="Center" />
                    <TextBlock Text="Mova o mouse aqui" Style="{StaticResource MfMutedText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Results per speed -->
            <Border Style="{StaticResource MfPanelStyle}" Padding="18,12,18,14" Margin="0,12,0,0">
                <Grid x:Name="ResultsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Velocidade da mão" Style="{StaticResource MfMutedText}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="Amostras" Style="{StaticResource MfMutedText}" FontSize="12" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Pixels por ponto" Style="{StaticResource MfMutedText}" FontSize="12" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Verdict -->
            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="VerdictIcon" FontSize="36" Filled="True" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictText" Style="{StaticResource MfTitleText}" />
                        <TextBlock x:Name="VerdictSubtext" Style="{StaticResource MfMutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:Button Content="Recomeçar" Icon="{ui:SymbolIcon ArrowReset24}" HorizontalAlignment="Right"
                       Margin="0,14,0,0" Click="ResetButton_Click" />
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
