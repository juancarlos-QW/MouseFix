<ui:FluentWindow x:Class="MouseFix.App.PrecisionTestWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Teste de precisão" Width="520" Height="620" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Teste de precisão" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,20">
            <ui:TextBlock TextWrapping="Wrap" Appearance="Secondary"
                          Text="Mova o mouse sobre a área abaixo: alguns movimentos bem devagar e outros bem rápidos, em várias direções. O teste compara o que o sensor do mouse leu com o quanto o cursor andou." />

            <!-- Movement area -->
            <Border x:Name="TestArea" Height="150" Margin="0,12,0,0" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ui:TextBlock x:Name="AreaHint" Text="Mova o mouse aqui" Appearance="Tertiary"
                              HorizontalAlignment="Center" VerticalAlignment="Center" FontTypography="BodyStrong" />
            </Border>

            <!-- Results per speed -->
            <ui:Card Margin="0,12,0,0">
                <Grid x:Name="ResultsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Text="Velocidade da mão" Appearance="Tertiary" />
                    <ui:TextBlock Grid.Column="1" Text="Amostras" Appearance="Tertiary" TextAlignment="Right" />
                    <ui:TextBlock Grid.Column="2" Text="Pixels por ponto" Appearance="Tertiary" TextAlignment="Right" />
                </Grid>
            </ui:Card>

            <!-- Verdict -->
            <ui:Card Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="VerdictIcon" FontSize="36" Filled="True" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock x:Name="VerdictText" FontTypography="BodyStrong" TextWrapping="Wrap" />
                        <ui:TextBlock x:Name="VerdictSubtext" Appearance="Secondary" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Button Content="Recomeçar" Icon="{ui:SymbolIcon ArrowReset24}" HorizontalAlignment="Right"
                       Margin="0,12,0,0" Click="ResetButton_Click" />
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
