<ui:FluentWindow x:Class="MouseFix.App.SensitivityWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Calculadora de sensibilidade" Width="500" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{StaticResource MfWindowBackground}">
    <StackPanel>
        <ui:TitleBar Title="Calculadora de sensibilidade" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,20">
            <TextBlock Style="{StaticResource MfMutedText}"
                       Text="Mostra quanto o cursor anda para cada centímetro que você move o mouse, com a aceleração desligada." />

            <!-- Inputs -->
            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DPI do mouse" Style="{StaticResource MfTitleText}" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="DpiBox" Grid.Column="1" TextChanged="Input_Changed" />
                    </Grid>
                    <TextBlock x:Name="DpiHint" Style="{StaticResource MfMutedText}" FontSize="12" Margin="0,6,0,0" />

                    <Border Style="{StaticResource MfDividerStyle}" Margin="0,14" />

                    <Grid>
                        <TextBlock Text="Velocidade do Windows" Style="{StaticResource MfTitleText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SpeedLabel" Style="{StaticResource MfTitleText}" Foreground="{StaticResource MfAccent}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="SpeedSlider" Style="{StaticResource MfSlider}" Minimum="1" Maximum="20" TickFrequency="1"
                            IsSnapToTickEnabled="True" Margin="0,10,0,0" Value="10" ValueChanged="SpeedSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="eDPI (DPI × velocidade)" Style="{StaticResource MfMutedText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EdpiValue" Grid.Column="1" Style="{StaticResource MfTitleText}" FontSize="18" Text="—" />
                    <TextBlock x:Name="PixelsPerCmLabel" Grid.Row="1" Text="Pixels por cm de movimento" Style="{StaticResource MfMutedText}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock x:Name="PixelsPerCmValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource MfTitleText}" FontSize="18"
                               Text="—" Margin="0,10,0,0" />
                    <TextBlock x:Name="CrossLabel" Grid.Row="2" Style="{StaticResource MfMutedText}" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock x:Name="CrossValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource MfTitleText}" FontSize="18"
                               Text="—" Margin="0,10,0,0" />
                </Grid>
            </Border>
            <TextBlock x:Name="EmulatorNote" Style="{StaticResource MfMutedText}" FontSize="12" Margin="2,8,0,0" />

            <!-- Changing DPI -->
            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Trocar de DPI sem mudar a sensação" Style="{StaticResource MfTitleText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DPI novo" Style="{StaticResource MfBodyText}" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="NewDpiBox" Grid.Column="1" TextChanged="Input_Changed" />
                    </Grid>
                    <TextBlock x:Name="NewDpiResult" Style="{StaticResource MfBodyText}" Margin="0,10,0,0" />
                    <TextBlock x:Name="OneToOneTip" Style="{StaticResource MfMutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <ui:Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
