<ui:FluentWindow x:Class="MouseFix.App.EmulatorTestWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:MouseFix.App"
                 Title="{l:T 'Teste do emulador', En='Emulator test'}" Width="500" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{StaticResource MfWindowBackground}">
    <StackPanel>
        <ui:TitleBar Title="{l:T 'Teste do emulador', En='Emulator test'}" ShowMaximize="False" />

        <StackPanel Margin="20,4,20,20">
            <TextBlock Style="{StaticResource MfMutedText}"
                       Text="{l:T 'Descobre se a mira do emulador segue o cursor do Windows (aí o MouseFix e a velocidade do ponteiro afetam o jogo) ou se lê o sensor do mouse direto.', En='Finds out whether the emulator\'s aim follows the Windows cursor (then MouseFix and the pointer speed affect the game) or reads the mouse sensor directly.'}" />

            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MfTitleText}" Text="{l:T 'Como fazer', En='How to do it'}" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,8,0,0"
                               Text="{l:T '1. Abra o jogo no emulador e entre num lugar parado, como o Campo de Treinamento, no modo de mira (cursor escondido).', En='1. Open the game in the emulator and go somewhere quiet, like the Training Ground, in aim mode (cursor hidden).'}" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="{l:T '2. Clique em &quot;Iniciar teste&quot; e volte para o jogo (Alt+Tab).', En='2. Click &quot;Start test&quot; and go back to the game (Alt+Tab).'}" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="{l:T '3. A cada 4 segundos a velocidade muda: bipe AGUDO = sua velocidade normal, bipe GRAVE = metade dela.', En='3. Every 4 seconds the speed changes: HIGH beep = your normal speed, LOW beep = half of it.'}" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="{l:T '4. Repita sempre o mesmo movimento (ex.: arraste o mouse uns 5 cm para o lado) e veja quanto a mira gira.', En='4. Repeat the same move every time (e.g. slide the mouse about 5 cm sideways) and watch how far the aim turns.'}" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="{l:T '5. Volte aqui, pare o teste e responda abaixo. A velocidade original volta sozinha.', En='5. Come back here, stop the test and answer below. The original speed comes back by itself.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PhaseText" Style="{StaticResource MfTitleText}" FontSize="18" Text="{l:T 'Parado', En='Stopped'}" />
                        <TextBlock x:Name="PhaseSubtext" Style="{StaticResource MfMutedText}" Margin="0,2,0,0"
                                   Text="{l:T 'O teste para sozinho depois de 2 minutos.', En='The test stops by itself after 2 minutes.'}" />
                    </StackPanel>
                    <ui:Button x:Name="StartStopButton" Grid.Column="1" Content="{l:T 'Iniciar teste', En='Start test'}" Icon="{ui:SymbolIcon Play24}"
                               Appearance="Primary" Margin="12,0,0,0" Click="StartStopButton_Click" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource MfTitleText}" Margin="2,18,0,0" Text="{l:T 'No bipe grave, a mira girou menos?', En='On the low beep, did the aim turn less?'}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ui:Button x:Name="YesButton" Content="{l:T 'Sim, girou menos', En='Yes, it turned less'}" Click="YesButton_Click" />
                <ui:Button x:Name="NoButton" Content="{l:T 'Não, girou igual', En='No, it turned the same'}" Margin="8,0,0,0" Click="NoButton_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
