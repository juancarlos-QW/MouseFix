<ui:FluentWindow x:Class="MouseFix.App.DistanceTestWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Teste de distância" Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/mousefix.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{StaticResource MfWindowBackground}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Teste de distância" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,20">
            <TextBlock Style="{StaticResource MfMutedText}"
                       Text="Verifica se o mouse ou o driver dele (ex.: Razer Synapse) aplica aceleração antes do Windows, e mede o DPI real e o polling rate." />

            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MfTitleText}" Text="Como fazer" />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,8,0,0"
                               Text="1. Encoste o mouse numa régua ou marque dois pontos no mousepad. Informe a distância abaixo." />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="2. Com o cursor na área abaixo, segure o botão esquerdo, arraste de uma marca até a outra e solte." />
                    <TextBlock Style="{StaticResource MfBodyText}" Margin="0,4,0,0"
                               Text="3. Faça 2 ou mais bem devagar (uns 2 segundos cada) e 2 ou mais bem rápidas, sempre a mesma distância." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Distância entre as marcas (cm)" Style="{StaticResource MfBodyText}" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="DistanceBox" Grid.Column="1" Text="10" TextChanged="DistanceBox_TextChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="TestArea" Height="110" Margin="0,12,0,0" Style="{StaticResource MfTestAreaStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Ruler24" FontSize="26" Foreground="{StaticResource MfAccent}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AreaHint" Text="Segure o botão esquerdo aqui e arraste"
                               Style="{StaticResource MfMutedText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="StrokesText" FontFamily="Consolas" Style="{StaticResource MfBodyText}" Text="Nenhuma arrastada ainda." />
                    <Border Style="{StaticResource MfDividerStyle}" Margin="0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="DPI medido" Style="{StaticResource MfMutedText}" />
                        <TextBlock x:Name="DpiValue" Grid.Column="1" Style="{StaticResource MfTitleText}" Text="—" />
                        <TextBlock Grid.Row="1" Text="Polling rate" Style="{StaticResource MfMutedText}" Margin="0,8,0,0" />
                        <TextBlock x:Name="PollingValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource MfTitleText}" Text="—" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MfPanelStyle}" Padding="18,14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="VerdictIcon" FontSize="36" Filled="True" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictText" Style="{StaticResource MfTitleText}" />
                        <TextBlock x:Name="VerdictSubtext" Style="{StaticResource MfMutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:Button Content="Recomeçar" Icon="{ui:SymbolIcon ArrowReset24}" HorizontalAlignment="Right"
                       Margin="0,14,0,0" Click="ResetButton_Click" />
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
